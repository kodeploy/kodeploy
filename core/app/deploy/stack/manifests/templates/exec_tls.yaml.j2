apiVersion: v1
kind: Secret                                             # kodeploy-exec 내부 문 TLS — exec Pod가 이 인증서로 8081을 열고, core는 이 인증서만 믿는다
metadata:
  name: {{ secret_name }}
  namespace: {{ tenant_id }}
  labels:
    tenant: {{ tenant_id }}
    managed-by: kodeploy
type: kubernetes.io/tls
data:
  tls.crt: {{ crt_b64 }}                                 # 자체 서명 (kodeploy-exec.<ns>.svc). 이미 있으면 그대로 둔다 (409 skip)
  tls.key: {{ key_b64 }}
