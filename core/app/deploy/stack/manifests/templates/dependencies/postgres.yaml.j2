apiVersion: v1
kind: Secret                                             # postgres 자격증명 — 비번은 백엔드가 자동 생성해서 주입
metadata:
  name: postgres-secret
  namespace: {{ tenant_id }}
  labels:
    app: postgres
    component: postgres
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: Opaque
stringData:                                              # base64 인코딩 안 해도 K8s가 자동 처리
  POSTGRES_USER: {{ username }}
  POSTGRES_PASSWORD: {{ password }}
  POSTGRES_DB: {{ database | default("app") }}
  # 앱 컨테이너에 envFrom으로 일괄 주입되는 표준 키 (mysql과 동일 컨벤션 — DB_*가 db 종류 무관)
  DB_HOST: postgres                                      # 같은 ns headless Service 이름
  DB_PORT: "5432"
  DB_NAME: {{ database | default("app") }}
  DB_USER: {{ username }}
  DB_PASSWORD: {{ password }}
  # Spring Boot Relaxed Binding 자동 인식 — application.properties 수정 0
  SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/{{ database | default("app") }}
  SPRING_DATASOURCE_USERNAME: {{ username }}
  SPRING_DATASOURCE_PASSWORD: {{ password }}
  # SQLAlchemy 등 Python OSS 표준
  DATABASE_URL: postgresql+psycopg2://{{ username }}:{{ password }}@postgres:5432/{{ database | default("app") }}
