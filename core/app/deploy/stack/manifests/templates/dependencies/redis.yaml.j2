apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: {{ tenant_id }}
  labels:
    app: redis
    component: redis
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: Opaque
stringData:
  REDIS_PASSWORD: {{ password }}
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  REDIS_URL: redis://:{{ password }}@redis:6379/0
  SPRING_DATA_REDIS_HOST: redis
  SPRING_DATA_REDIS_PORT: "6379"
  SPRING_DATA_REDIS_PASSWORD: {{ password }}
