apiVersion: v1
kind: Secret                                             # mysql 자격증명 — 비번은 백엔드가 자동 생성해서 주입
metadata:
  name: mysql-secret
  namespace: {{ tenant_id }}
  labels:
    app: mysql
    component: mysql
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: Opaque
stringData:                                              # base64 인코딩 안 해도 K8s가 자동 처리 (data와 달리)
  MYSQL_ROOT_PASSWORD: {{ root_password }}               # 백엔드 secrets.token_urlsafe(24)로 생성
  MYSQL_USER: {{ username }}
  MYSQL_PASSWORD: {{ password }}
  # 앱 컨테이너에 envFrom으로 일괄 주입되는 표준 키 (runtime/framework 무관 단일 컨벤션)
  DB_HOST: mysql                                         # 같은 ns headless Service 이름
  DB_PORT: "3306"
  DB_NAME: {{ database | default("app") }}
  DB_USER: {{ username }}
  DB_PASSWORD: {{ password }}
  # Spring Boot Relaxed Binding 자동 인식 — application.properties 수정 0
  SPRING_DATASOURCE_URL: jdbc:mysql://mysql:3306/{{ database | default("app") }}?useSSL=false&allowPublicKeyRetrieval=true
  SPRING_DATASOURCE_USERNAME: {{ username }}
  SPRING_DATASOURCE_PASSWORD: {{ password }}
  # SQLAlchemy 등 Python OSS의 표준 
  DATABASE_URL: mysql+pymysql://{{ username }}:{{ password }}@mysql:3306/{{ database | default("app") }}
