apiVersion: v1
kind: Namespace                                          # 유저별 격리 단위 — 같은 ns 안에 그 유저 워크로드 전부
metadata:
  name: {{ tenant_id }}
  labels:
    user: "{{ user_id }}"                                # 소유자 추적용 (kubectl get ns -l user=<uuid>)
    tenant: "{{ tenant_id }}"
    pod-security.kubernetes.io/enforce: restricted       # PSS 최고 보안 프로파일 — privileged/hostPath/runAsRoot 차단
    pod-security.kubernetes.io/enforce-version: v1.30    # 정책 버전 핀 (K8s 업그레이드 시 동작 변동 방지)
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding                                        # core가 이 ns 안에서만 쓰는 권한 (Secret·PVC·Pod 로그·exec)
metadata:
  name: kodeploy-core
  namespace: {{ tenant_id }}
  labels:
    tenant: {{ tenant_id }}
    managed-by: kodeploy
roleRef:                                                 # 다른 ns에선 이 권한이 없다 — argocd·kube-system의 Secret·exec 차단
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kodeploy-core-tenant
subjects:                                                # 만들 수 있는 모양은 admission 정책이 이것 하나로 묶는다 (deploy/k8s/core/admission-policy.yaml)
  - kind: ServiceAccount
    name: kodeploy-core
    namespace: default
---
apiVersion: v1
kind: Secret                                             # 유저 앱 이미지 pull용 (private GHCR 인증)
metadata:
  name: ghcr-auth
  namespace: {{ tenant_id }}
  labels:
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: kubernetes.io/dockerconfigjson                     # K8s가 imagePullSecrets로 인식하는 표준 타입
data:
  .dockerconfigjson: {{ dockerconfigjson_b64 }}          # 운영 ghcr-auth와 같은 값 복사 (백엔드 env로 들고 있음)
